{
  "name": "@wssdll/dsh-chat-preset",
  "version": "1.2.0",
  "type": "module",
  "description": "DSH 纯净聊天模式预设。Schema 从 ~9 458 tok 降到 ~376 tok，降低约 25 倍。只保留联网搜索、打开网页、读取附件（文档、图片）三个工具，中文思维链，尽可能还原网页版。「设置」-「Agent 预设」-「聊天模式」，或者在新对话中将「标准模式」切换为「聊天模式」。",
  "author": "wssdll",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "agent-preset",
    "chat"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wssdll/dsh-chat-preset.git"
  },
  "homepage": "https://github.com/wssdll/dsh-chat-preset",
  "bugs": {
    "url": "https://github.com/wssdll/dsh-chat-preset/issues"
  },
  "engines": {
    "dsh": ">=0.2.2-rc.1 <0.3.0-0"
  },
  "files": [
    "cordis.patch.yml",
    "guard-tools.js",
    "README.md",
    "screenshot-1.png",
    "screenshot-2.png"
  ],
  "exports": {
    "./guard-tools": "./guard-tools.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
