{
  "name": "@wssdll/dsh-chat-preset",
  "version": "1.3.4",
  "type": "module",
  "description": "DSH 纯净聊天模式预设。工具 Schema 从 ~7 589 tok 降到 ~350 tok，降低约 22 倍。只保留联网搜索、打开网页、读取附件三个工具，中文思维链，尽可能还原网页版。「设置」-「Agent 预设」-「聊天模式」，或者在新对话中将「标准模式」切换为「聊天模式」。",
  "author": "wssdll",
  "license": "MIT",
  "icon": "assets/icon.svg",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "deepseek-harness",
    "cordis",
    "agent-preset",
    "chat",
    "chat-preset",
    "chinese",
    "web-search"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wssdll/dsh-chat-preset.git"
  },
  "homepage": "https://github.com/wssdll/dsh-chat-preset",
  "bugs": {
    "url": "https://github.com/wssdll/dsh-chat-preset/issues"
  },
  "engines": {
    "dsh": ">=0.2.2-rc.1 <0.3.0-0"
  },
  "files": [
    "cordis.patch.yml",
    "index.js",
    "plugins",
    "locale",
    "assets/icon.svg",
    "screenshot-1.png",
    "screenshot-2.png",
    "screenshots.json",
    "README.md"
  ],
  "exports": {
    ".": "./index.js",
    "./guard-tools": "./plugins/guard-tools.js",
    "./clock": "./plugins/clock.js",
    "./no-cwd": "./plugins/no-cwd.js",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
